# Copie para ".env" e preencha (não commite ".env").
#
# Groq — necessário para Text-to-SQL (pydantic-ai / groq:model)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=

# Postgres (opcional — usado quando conectar à camada Gold real;
# testes locais usam mock_gold.sqlite sem estas variáveis)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
