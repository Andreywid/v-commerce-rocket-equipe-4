# Copie para ".env" e preencha (não commite ".env").
#
# LLM — necessário para Text-to-SQL (PydanticAI)
#
# SISTEMA DE FALLBACK:
# - Modelo padrão (primário): Gemini 2.5 Flash-Lite
# - Modelo fallback (secundário): Gemini 3.1 Flash-Lite
#
# Se o modelo primário falhar na inicialização, o agente tenta automaticamente
# com o modelo fallback. Se nenhum modelo estiver disponível, uma exceção é levantada.
#
# Deixe vazio ou comente para usar o padrão (Gemini 2.5 Flash-Lite):
# LLM_MODEL=google-gla:gemini-3.1-flash-lite
#
# Para usar um modelo customizado, defina:
# LLM_MODEL=google-gla:seu-modelo-aqui
#
# Obtenha sua chave API em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
#
# Compatibilidade: se GOOGLE_API_KEY não existir, o app usa API_KEY como fallback.
API_KEY=

# Postgres (opcional — usado quando conectar à camada Gold real;
# testes locais usam mock_gold.sqlite sem estas variáveis)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
